rules_version = '2';

// Ladin Ormanı — Firestore güvenlik kuralları
// Yayınlama: Firebase konsolu → Firestore Database → Kurallar → bu dosyanın tamamını yapıştır → Yayınla.
//
// Veri modeli:  kullanicilar/{uid}
//   ad             string (1-60)    kullanıcı yazar
//   eposta         string           kayıtta oturumdaki e-posta ile aynı olmalı; sonra değişmez
//   ogretmenTalebi bool             kullanıcı işaretler ("öğretmenim" talebi)
//   kvkkOnay       timestamp        kayıt anı (sunucu saati); sonra değişmez
//   olusturma      timestamp        kayıt anı (sunucu saati); sonra değişmez
//   rol            string           YALNIZ Firebase konsolundan yazılır ("ogretmen"). Alan yoksa rol "ogrenci" sayılır.
//
// İstemci "rol" alanını ne oluştururken ne güncellerken yazabilir.
// (Konsol ve Admin SDK bu kurallara tabi değildir.)

service cloud.firestore {
  match /databases/{database}/documents {

    function kendi(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function alanlarGecerli(d) {
      return d.ad is string && d.ad.size() >= 1 && d.ad.size() <= 60
          && d.ogretmenTalebi is bool;
    }

    match /kullanicilar/{uid} {
      // Yalnız kendi belgesini okuyabilir; toplu listeleme yok.
      allow get: if kendi(uid);
      allow list: if false;

      // Kayıt: yalnız izin verilen beş alan, hepsi zorunlu. "rol" yazılamaz.
      allow create: if kendi(uid)
        && request.resource.data.keys().hasOnly(['ad', 'eposta', 'ogretmenTalebi', 'kvkkOnay', 'olusturma'])
        && request.resource.data.keys().hasAll(['ad', 'eposta', 'ogretmenTalebi', 'kvkkOnay', 'olusturma'])
        && alanlarGecerli(request.resource.data)
        && request.resource.data.eposta == request.auth.token.email
        && request.resource.data.kvkkOnay == request.time
        && request.resource.data.olusturma == request.time;

      // Güncelleme: yalnız "ad" ve "ogretmenTalebi" değişebilir.
      // "rol" dahil başka hiçbir alan eklenemez, silinemez, değiştirilemez.
      allow update: if kendi(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad', 'ogretmenTalebi'])
        && alanlarGecerli(request.resource.data);

      // Kullanıcı kendi kaydını silebilir (KVKK: silme hakkı).
      allow delete: if kendi(uid);
    }

    // Başka hiçbir koleksiyona istemciden erişim yok.
    match /{belge=**} {
      allow read, write: if false;
    }
  }
}
